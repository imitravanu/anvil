#!/bin/sh
# Anvil Guardian pre-commit hook (hardening, 2026-09-13, rev 2 — self-contained).
#
# PROVEN ATTACK (do not regress): delegating the decision to the gate script
# is NOT safe — an agent can weaken that script in the worktree and flip its
# exit code, making the hook's decision attacker-controlled. This hook is
# therefore SELF-CONTAINED: it trusts nothing from the worktree and only reads
# the STAGED diff via porcelain git. Git hooks are advisory, not security —
# `--no-verify` bypasses them by design — but the lazy attack class (staging a
# weakened gate + re-hashed manifest) must be refused at commit time, loudly.
#
# The full auditability lives in `npm run gate` (build/typecheck/full test
# suite/eval + manifest + residual scan) and in CI + PR review, which no local
# process can skip. Install (per clone):  npm run hooks:install
#
# AUDIT-06: this header used to name a fixed test count ("566 tests") that
# silently rotted as the suite grew. It now names the step, not a number.
#
# PARITY CONTRACT (Batch M): Layer B is a PRE-FLIGHT of the gate's Step 1, not
# a second opinion. It reads the same scan roots and extensions, splits its
# rules by the same path predicate, and carries the same rules — so a commit is
# never refused on work `npm run gate` accepts, and the hook never accepts a
# line the gate's own rule set rejects. Getting the path split wrong diverges
# in one of two directions and both are bugs: a rule applied to a path the gate
# exempts blocks sanctioned work (13 test files hold fixture casts the gate
# allows), and a rule missing here lets slop through that the gate would stop.
# The gate stays the authority — this layer only fails faster. A rule added
# there belongs here in the same commit; the differential suite in
# packages/cli/src/__tests__/preCommitHook.test.ts fails if the two drift, and
# the cross-checkpoint drift test in packages/cli/src/__tests__/
# gate.sentinel.test.ts fails if this layer, the gate and the in-process
# guardian stop answering identically for the same path. The exemption policy
# itself is documented once, in AGENTS.md Section 2 rule 11.
set -u

# --- Layer A: protected-path tamper refusal (self-contained) ----------------
# `while read` over the newline-delimited list, not `for f in $(...)`: word
# splitting broke paths containing spaces (2026-10-10), so a staged protected
# path with a space could slip the refusal. Layer B below already used this
# heredoc idiom; Layer A now matches it. Paths with embedded newlines remain
# out of scope exactly as before — git C-quotes those, and they arrive as one
# quoted string that matches no case pattern.
blocked=""
while IFS= read -r f; do
  case "$f" in
    scripts/verify-gate.mjs|scripts/gate-manifest.json|.githooks/pre-commit|\
    AGENTS.md|.fresh-allowlist.json|docs/PHASE-21-25-AUDIT.md|\
    packages/cli/src/__tests__/gate.sentinel.test.ts|.github/workflows/*)
      blocked="$blocked $f" ;;
  esac
done <<EOF
$(git diff --cached --name-only)
EOF
if [ -n "$blocked" ]; then
  echo "🔴 PROTECTED ARTIFACT CHANGE DETECTED (staged):$blocked" >&2
  echo "   Human review required." >&2
  echo "   Humans: git commit --no-verify (deliberate + visible; CI full gate + PR review still apply)." >&2
  exit 1
fi

# --- Layer B: staged slop scan — the gate's Step 1 rule set, split by path ---
#
# The gate judges a TEST path (`__tests__` or `.test.`) by the skipped-test
# rule ALONE and everything else by the remaining rules; that split (AGENTS.md
# Section 2 rule 11, TEST-FILE EXEMPTION POLICY) is reproduced exactly here.
# Scope mirrors the gate's SCAN_ROOTS x SCAN_EXTS, minus its fixture dir and
# its two Step-1 self-exempt paths.
#
# Two gate checks cannot be expressed as a per-line grep: the brace-aware
# non-empty silent catch, and the multiline pass that catches a rule evaded by
# splitting it across two added lines. Both are ported to POSIX awk below. If
# awk is missing the pair runs LOUDLY reduced: it then under-refuses (the gate
# still catches it) instead of ever over-refusing a commit the gate accepts.
#
# The magic-literal regex is the gate's MAGIC_TIMEOUT_RE translated for POSIX
# ERE: `(?:...)` -> `(...)` (ERE has no non-capturing groups), `\d` -> `[0-9]`,
# `\s` -> `[[:space:]]`. Every literal and quantifier is otherwise verbatim.
MAGIC_RE='\b(timeout|timeoutMs|idleMs|maxWaitMs|maxBuffer|retries|maxRetries|delayMs|debounceMs|intervalMs)[[:space:]]*[:=][[:space:]]*[1-9][0-9_]*\b|\bset(Timeout|Interval)[[:space:]]*\([^,]+,[[:space:]]*[1-9][0-9_]*[[:space:]]*\)|\bMath\.pow\([[:space:]]*[0-9][0-9_]*(\.[0-9]+)?[[:space:]]*,'

# Reads one file's added lines on stdin, `+` already stripped. `hasraw=1` means
# the line-oriented rules already flagged this file, which (exactly as in the
# gate) suppresses the multiline pass. Prints one line per finding.
PARITY_AWK=$(cat <<'PARITY_AWK'
function iscomment(s) { return (s ~ /^[[:space:]]*(\/\/|[*]|\/[*])/) }
{
  src[++nlines] = $0
  text = text $0 "\n"
}
END {
  # (1) Multiline pass: a rule split across two ADJACENT added lines, skipping
  #     a pair that touches a comment (a comment cannot execute, and a comment
  #     inside a catch is the Section 2.3 rationale).
  if (hasraw != 1) {
    for (i = 1; i < nlines; i++) {
      if (iscomment(src[i]) || iscomment(src[i + 1])) continue
      joined = src[i] "\n" src[i + 1]
      if (joined ~ /(^|[^A-Za-z0-9_])as[[:space:]]*\n[[:space:]]*(any|never)([^A-Za-z0-9_]|$)/) {
        printf "lines %d-%d: type escape split across lines\n", i, i + 1
      } else if (joined ~ /catch[[:space:]]*(\([^)]*\))?[[:space:]]*\{[[:space:]]*\}/) {
        printf "lines %d-%d: silent catch split across lines\n", i, i + 1
      } else if (joined ~ /instanceof[[:space:]]*\n[[:space:]]*Error[[:space:]]*\?/ ||
                 joined ~ /instanceof[[:space:]]+Error[[:space:]]*\n[[:space:]]*\?/) {
        printf "lines %d-%d: raw error formatting split across lines\n", i, i + 1
      }
    }
  }
  # (2) Silent catch (the gate's silentCatchLines): a NON-empty catch body that
  #     neither surfaces the failure nor carries any comment. `0` false: the
  #     first "{" at or after the match — not always the body brace — is what
  #     the gate brace-matches, and a "fixed" hook would refuse a line the gate
  #     accepts, so the quirk is reproduced rather than corrected.
  n = length(text)
  pos = 1
  while (pos <= n) {
    p = index(substr(text, pos), "catch")
    if (p == 0) break
    m = pos + p - 1
    i = skipspace(text, m + 5, n)
    if (substr(text, i, 1) == "(") {
      j = i + 1
      while (j <= n && substr(text, j, 1) != ")") j++
      if (j > n) { pos = m + 1; continue }
      i = skipspace(text, j + 1, n)
    }
    if (substr(text, i, 1) != "{") { pos = m + 1; continue }
    matchEnd = i
    oi = m
    while (oi <= n && substr(text, oi, 1) != "{") oi++
    if (oi > n) { pos = matchEnd + 1; continue }
    k = m
    while (k >= 1 && substr(text, k, 1) != "\n") k--
    ls = k + 1
    le = index(substr(text, m), "\n")
    if (le == 0) le = n + 1; else le = m + le - 1
    line = substr(text, ls, le - ls)
    before = substr(text, ls, m - ls)
    if (line ~ /^[[:space:]]*(\/\/|[*]|\/[*])/ || before ~ /\/\//) { pos = matchEnd + 1; continue }
    depth = 0; body = ""; closed = 0
    t = oi
    while (t <= n) {
      c = substr(text, t, 1)
      if (c == "{") depth++
      else if (c == "}") { depth--; if (depth == 0) { body = substr(text, oi + 1, t - oi - 1); closed = 1; break } }
      t++
    }
    if (!closed) body = substr(text, oi + 1)
    b = body
    gsub(/^[[:space:]]+/, "", b)
    gsub(/[[:space:]]+$/, "", b)
    if (b == "") { pos = matchEnd + 1; continue }
    if (tolower(b) ~ /log[.]|console[.]|printsystemmessage|geterrormessage|(^|[^a-z0-9_])throw([^a-z0-9_]|$)|error|problem|fail|warn|\/\/|\/\*/) {
      pos = matchEnd + 1
      continue
    }
    ln = 1
    for (q = 1; q < m; q++) if (substr(text, q, 1) == "\n") ln++
    printf "line %d: silent catch with no log or rationale\n", ln
    pos = matchEnd + 1
  }
}
function skipspace(s, i, n) {
  while (i <= n && substr(s, i, 1) ~ /[[:space:]]/) i++
  return i
}
PARITY_AWK
)

if ! command -v awk >/dev/null 2>&1; then
  echo "⚠ pre-commit: awk not found — the multiline and brace-aware silent-catch families are NOT checked here (npm run gate still enforces them)." >&2
  PARITY_AWK=""
fi

violations=""
# An unquoted heredoc performs no field splitting, so a path with spaces stays
# one line (a `for` over command substitution would split it).
while IFS= read -r f; do
  [ -n "$f" ] || continue
  case "$f" in
    packages/core/src/*|packages/core/scripts/*|packages/tui/src/*|\
    packages/tui/scripts/*|packages/cli/src/*|scripts/*|evals/*) ;;
    *) continue ;;
  esac
  case "$f" in
    evals/tasks/*|scripts/verify-gate.mjs|\
    packages/cli/src/__tests__/gate.sentinel.test.ts) continue ;;
  esac
  case "$f" in
    # Parity with the gate's SCAN_EXTS (pinned by the sentinel): a new
    # extension there without its twin here is silent under-refusal.
    *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.mts|*.cts) ;;
    *) continue ;;
  esac

  added=$(git diff --cached -- "$f" | grep -E '^\+' | grep -vE '^\+\+\+' | sed 's/^\+//' || true)
  if [ -z "$added" ]; then continue; fi

  hits=""
  add_hit() { hits="$hits
  $1: $2"; }

  case "$f" in
    *__tests__*|*.test.*)
      # gate Rule 2.10 — the ONLY rule a test path is judged by.
      h=$(printf '%s\n' "$added" | grep -nE '\b(it|test|describe)\.skip\b|\b(xit|xtest|xdescribe)[[:space:]]*\(' || true)
      [ -n "$h" ] && add_hit "skipped test" "$h"
      ;;
    *)
      # A comment cannot execute, so the code rules judge code lines only. Two
      # gate rules are deliberately comment-visible: the placeholder marker (a
      # marker in a comment is the target) and the TypeScript suppression.
      code=$(printf '%s\n' "$added" | grep -vE '^[[:space:]]*(//|\*|/\*)' || true)

      h=$(printf '%s\n' "$added" | grep -nE '@ts-(ignore|nocheck)\b' || true)
      [ -n "$h" ] && add_hit "ts suppression" "$h"

      h=$(printf '%s\n' "$code" | grep -nE '\bas[[:space:]]+(any|never)\b' || true)
      [ -n "$h" ] && add_hit "type escape" "$h"

      # The gate's `(?<!\?)` lookbehind, spelled as an alternation: grep -E has
      # no lookbehind, so "a colon at line start, or preceded by anything but a
      # question mark" is exact — it keeps `(?:any` from reading as `: any`.
      # Batch O+ (takeover): the array position is the authority's EMPTY pair —
      # an indexed access (`conf.any[0]`) is property access, not an annotation.
      h=$(printf '%s\n' "$code" | grep -nE '(^|[^?]):[[:space:]]*any\b|<[[:space:]]*any\b|,[[:space:]]*any\b|\bany[[:space:]]*\[\]' || true)
      [ -n "$h" ] && add_hit "bare any annotation" "$h"

      h=$(printf '%s\n' "$code" | grep -nE '\bas[[:space:]]+Error\b' || true)
      [ -n "$h" ] && add_hit "as Error cast" "$h"

      h=$(printf '%s\n' "$code" | grep -nE 'instanceof[[:space:]]+Error[[:space:]]*\?' || true)
      if [ -z "$h" ]; then
        h=$(printf '%s\n' "$code" | grep -nE '\.message[[:space:]]*\?\?[[:space:]]*String[[:space:]]*\(' || true)
      fi
      [ -n "$h" ] && add_hit "raw error formatting" "$h"

      h=$(printf '%s\n' "$code" | grep -nE 'catch[[:space:]]*(\([^)]*\))?[[:space:]]*\{[[:space:]]*\}' || true)
      [ -n "$h" ] && add_hit "empty catch" "$h"

      # Template-literal content is generated text, not code — skipped.
      h=$(printf '%s\n' "$code" | grep -vE "^[[:space:]]*[\`'\"]" | grep -nE "$MAGIC_RE" || true)
      [ -n "$h" ] && add_hit "magic timeout/retry/cap literal" "$h"

      case "$f" in
        packages/core/*)
          h=$(printf '%s\n' "$code" | grep -nE '@(anvil/|imitravanu/anvil-)(tui|cli)' || true)
          [ -n "$h" ] && add_hit "core boundary" "$h" ;;
      esac

      case "$f" in
        packages/tui/src/components/*)
          h=$(printf '%s\n' "$code" | grep -nE '\b(color|borderColor|backgroundColor)[[:space:]]*=[[:space:]]*(\{[[:space:]]*`(cyan|green|red|yellow|blue|magenta|white|black|gray)`[[:space:]]*\}|["'\''](cyan|green|red|yellow|blue|magenta|white|black|gray)["'\'']|`(cyan|green|red|yellow|blue|magenta|white|black|gray)`)' || true)
          [ -n "$h" ] && add_hit "hardcoded TUI color" "$h" ;;
      esac

      h=$(printf '%s\n' "$added" | grep -nE '\b(TODO|FIXME|XXX)\b' || true)
      [ -n "$h" ] && add_hit "placeholder marker" "$h"

      if [ -n "$PARITY_AWK" ]; then
        if [ -n "$hits" ]; then raw=1; else raw=0; fi
        h=$(printf '%s\n' "$added" | awk -v hasraw="$raw" "$PARITY_AWK" || true)
        [ -n "$h" ] && add_hit "multiline/silent catch" "$h"
      fi
      ;;
  esac

  [ -n "$hits" ] && violations="$violations
$f:$hits"
done <<EOF
$(git diff --cached --name-only --diff-filter=ACM)
EOF

if [ -n "$violations" ]; then
  echo "🧟 SLOP PATTERNS DETECTED IN STAGED FILES (gate Step 1 rules, pre-flighted):" >&2
  printf '%s\n' "$violations" >&2
  echo "   Migrate to getErrorMessage() / typed casts / config constants. Full rules: npm run gate" >&2
  exit 1
fi

exit 0
