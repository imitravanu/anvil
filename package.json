{
  "name": "anvil",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @anvil/core && npm run build -w @anvil/tui && npm run build -w @anvil/cli",
    "dev": "npm run dev --workspace=packages/cli",
    "typecheck": "npm run typecheck -w @anvil/core && npm run typecheck -w @anvil/tui && npm run typecheck -w @anvil/cli && tsc -p tsconfig.scripts.json",
    "test": "npm run test --workspaces --if-present",
    "coverage": "npm run coverage --workspaces --if-present",
    "visual": "npm run visual -w @anvil/tui",
    "visual:capture": "npm run visual:capture -w @anvil/tui",
    "visual:diff": "npm run visual:diff -w @anvil/tui",
    "visual:approve": "npm run visual:approve -w @anvil/tui",
    "eval": "npx tsx evals/run.ts",
    "eval:report": "npx tsx evals/run.ts --report",
    "certify": "npx tsx scripts/certify-provider.ts",
    "certify:all": "bash scripts/certify-all.sh",
    "gate": "node scripts/verify-gate.mjs",
    "hooks:install": "git config core.hooksPath .githooks && chmod +x .githooks/pre-commit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "description": "Anvil — a terminal-based AI coding agent (monorepo: core, tui, cli)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imitravanu/anvil.git"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "terminal",
    "ink",
    "tui",
    "cli",
    "llm"
  ],
  "license": "MIT"
}
