# =============================================================================
# ANVIL Environment Configuration Template
# =============================================================================
# Copy this file to .env and uncomment the variables you want to override.
# All values shown are the built-in defaults — only set what you need.
# API keys can also be stored in ~/.anvil/credentials.json (preferred for
# production use). Env vars take precedence over credentials.json.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 1. Provider API Keys
#    At least one is required. Keys here override ~/.anvil/credentials.json.
#    Aliases (e.g. GOOGLE_API_KEY for GEMINI) are shown inline.
# ─────────────────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=                   # Anthropic (Claude) API key
# OPENAI_API_KEY=                     # OpenAI API key
# GEMINI_API_KEY=                     # Google Gemini API key
# GOOGLE_API_KEY=                     # Alias for GEMINI_API_KEY
# OPENROUTER_API_KEY=                 # OpenRouter API key
# ORCAROUTER_API_KEY=                 # Orcarouter API key
# GROQ_API_KEY=                       # Groq API key
# CEREBRAS_API_KEY=                   # Cerebras API key
# GITHUB_TOKEN=                       # GitHub API token (alias: GITHUB_API_KEY)
# MISTRAL_API_KEY=                    # Mistral API key
# OLLAMA_API_KEY=                     # Ollama API key (optional for local)
# OLLAMA_HOST=                        # Ollama server URL (e.g. http://localhost:11434)

# ─────────────────────────────────────────────────────────────────────────────
# 2. Provider Model Overrides
#    Override the default model used by each provider's verify/cert scripts.
# ─────────────────────────────────────────────────────────────────────────────
# OPENROUTER_MODEL=cohere/north-mini-code:free   # OpenRouter model override
# ORCAROUTER_MODEL=z-ai/glm-5.3-flash-free       # Orcarouter model override
# GEMINI_MODEL=gemini-3.1-pro-preview             # Gemini model override

# ─────────────────────────────────────────────────────────────────────────────
# 3. Core Settings
# ─────────────────────────────────────────────────────────────────────────────
# ANVIL_HOME=~/.anvil                   # Root directory for config, credentials, checkpoints
# ANVIL_PROVIDER=                       # Force a specific provider (e.g. anthropic, openai, gemini)
# ANVIL_MODEL=                          # Force a specific model ID (provider must match)
# ANVIL_DEBUG=                          # Enable debug logging (set to "1" or any truthy value)

# ─────────────────────────────────────────────────────────────────────────────
# 4. Tool Limits
# ─────────────────────────────────────────────────────────────────────────────
# ANVIL_MAX_READ_BYTES=524288           # Max bytes read per file tool call (512 KB)
# ANVIL_RUN_COMMAND_TIMEOUT_MS=120000   # Default bash/command timeout (2 min)
# ANVIL_MAX_STREAM_BYTES=20480          # Max captured bytes per output stream (20 KB)
# ANVIL_RUN_TEST_TIMEOUT_MS=60000       # Test-runner timeout per invocation (1 min)

# ─────────────────────────────────────────────────────────────────────────────
# 5. Context Window & Compaction
# ─────────────────────────────────────────────────────────────────────────────
# ANVIL_FALLBACK_CONTEXT_WINDOW=32000   # Fallback context window size (tokens) when provider unknown
# ANVIL_COMPACTION_THRESHOLD=0.75       # Fraction of context window that triggers compaction
# ANVIL_CONTEXT_WARN_THRESHOLD=0.6      # Fraction of context window that triggers a warning
# ANVIL_KEEP_RECENT_MESSAGES=6          # Number of recent messages preserved during compaction

# ─────────────────────────────────────────────────────────────────────────────
# 6. Agent Iteration & Verification Budgets
# ─────────────────────────────────────────────────────────────────────────────
# ANVIL_MAX_INNER_ITERATIONS=20         # Max inner-loop iterations per agent turn
# ANVIL_MAX_VERIFY_REPAIRS=2            # Max auto-repair attempts per verification cycle
# ANVIL_CHECKPOINT_KEEP=5               # Number of checkpoint files retained per session

# ─────────────────────────────────────────────────────────────────────────────
# 7. Guardian
# ─────────────────────────────────────────────────────────────────────────────
# ANVIL_GUARDIAN_MAX_FIXES=10           # Max automatic fixes the guardian gate will attempt
# ANVIL_PROVIDER_STREAM_RETRIES=2       # Retries on provider streaming errors before giving up

# ─────────────────────────────────────────────────────────────────────────────
# 8. MCP (Model Context Protocol)
# ─────────────────────────────────────────────────────────────────────────────
# ANVIL_MCP_TIMEOUT_MS=30000            # Per-request timeout for MCP server calls (30 s)
# ANVIL_SSE_CONNECT_RETRIES=3           # Max SSE transport connection retries with backoff
# ANVIL_SSE_CONNECT_RETRY_MS=500        # Initial SSE reconnect delay (ms), exponential backoff
# ANVIL_SSE_CONNECT_RETRY_MAX_MS=8000   # Max SSE reconnect delay cap (ms)

# ─────────────────────────────────────────────────────────────────────────────
# 9. Subagent & Summarizer
# ─────────────────────────────────────────────────────────────────────────────
# ANVIL_MAX_SUBAGENT_REPORT_CHARS=8000  # Max characters in a subagent's completion report
# ANVIL_SUMMARIZER_TOOL_ERROR_CHARS=500 # Max error excerpt chars passed to the compaction summarizer

# ─────────────────────────────────────────────────────────────────────────────
# 10. UI / UX
# ─────────────────────────────────────────────────────────────────────────────
# ANVIL_NO_ALT_SCREEN=                 # Disable alternate screen buffer (set to "1" to disable)
# ANVIL_NOTIFY_AFTER_MS=60000          # Delay before showing a "still working" notification (60 s)
# ANVIL_CLIPBOARD_MAX_BYTES=102400     # Max bytes for clipboard operations (100 KB)
# ANVIL_TOKEN_HISTORY_CAP=24           # Number of token-usage history entries retained

# ─────────────────────────────────────────────────────────────────────────────
# 11. Advanced — Team, LSP, Plugins
# ─────────────────────────────────────────────────────────────────────────────
# ANVIL_TEAM_MAX_AGENTS=5              # Max agents in a team orchestration
# ANVIL_TEAM_ITERATIONS=12             # Default iteration budget for team workflows
# ANVIL_LSP_TIMEOUT_MS=15000           # Language Server Protocol request timeout (15 s)
# ANVIL_LSP_MAX_DIAGNOSTICS=100        # Max diagnostics fetched per LSP request
# ANVIL_PLUGIN_MAX_TOOLS=20            # Max tools a single plugin can register

# ─────────────────────────────────────────────────────────────────────────────
# 12. Testing
# ─────────────────────────────────────────────────────────────────────────────
# ANVIL_TEST_ENV_ALLOW=                # Comma-separated env var names forwarded to test runners
