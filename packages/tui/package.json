{
  "name": "@anvil/tui",
  "version": "1.5.0",
  "description": "Ink terminal UI for the Anvil coding agent.",
  "author": "mitravanu",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "repository": { "type": "git", "url": "git+https://github.com/imitravanu/anvil.git", "directory": "packages/tui" },
  "keywords": [
    "ai",
    "coding-agent",
    "terminal",
    "ink",
    "tui"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "visual": "vitest run src/__visual__/visual.test.tsx",
    "visual:update": "VISUAL_UPDATE=1 vitest run src/__visual__/visual.test.tsx",
    "visual:capture": "node scripts/visual-capture.mjs",
    "visual:diff": "node scripts/visual-diff.mjs",
    "visual:approve": "node scripts/visual-approve.mjs"
  },
  "dependencies": {
    "cli-truncate": "^6.1.1",
    "string-width": "^8.3.0",
    "wrap-ansi": "^10.0.2",
    "@anvil/core": "*",
    "cli-highlight": "^2.1.11",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.0",
    "ansi-to-html": "^0.7.2",
    "ink-testing-library": "^4.0.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.10.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  }
}
