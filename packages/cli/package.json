{
  "name": "@imitravanu/anvil-cli",
  "version": "1.5.1",
  "description": "A terminal-based AI coding agent with interactive permission prompts.",
  "author": "mitravanu",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imitravanu/anvil.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "terminal",
    "cli",
    "ink"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "anvil": "bin/anvil.cjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc -p . --noEmit && esbuild src/index.tsx --bundle --platform=node --format=esm --outfile=dist/index.js --alias:react-devtools-core=./src/devtools-shim.js --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "dev": "tsx src/index.tsx",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p . --noEmit"
  },
  "devDependencies": {
    "@imitravanu/anvil-core": "1.5.1",
    "@imitravanu/anvil-tui": "1.5.1",
    "@types/react": "^19.2.0",
    "ink": "^7.1.1",
    "react": "^19.2.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
